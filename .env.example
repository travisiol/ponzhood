# PONZHOOD — environment
#
# Every address below is read at build time and rendered as "Awaiting launch"
# while it is unset. Nothing here has a hardcoded fallback: an address that is
# not set cannot show up on the site pretending to be deployed.

NEXT_PUBLIC_SITE_URL=https://ponzhood.example

# Flip to "true" only once the launcher is live. Until then the pages that
# would read the chain say so instead of showing invented figures.
NEXT_PUBLIC_PONZHOOD_LIVE=false

# Chain
NEXT_PUBLIC_PONZHOOD_RPC_URL=https://rpc.rbh.network
NEXT_PUBLIC_PONZHOOD_EXPLORER=https://explorer.rbh.network

# Ours — deployed once, reused by every launch
NEXT_PUBLIC_PONZHOOD_LAUNCHER=
NEXT_PUBLIC_PONZHOOD_REGISTRY=
NEXT_PUBLIC_PONZHOOD_STAKING_FACTORY=
NEXT_PUBLIC_PONZHOOD_STAKEBURN_FACTORY=
NEXT_PUBLIC_PONZHOOD_RWA_FACTORY=
NEXT_PUBLIC_PONZHOOD_LOTTERY_FACTORY=

# Not ours — pons and the chain
NEXT_PUBLIC_PONS_FACTORY=
NEXT_PUBLIC_PONS_ESCROW=
NEXT_PUBLIC_UNISWAP_POOL_MANAGER=

# Social. Unset renders as "awaiting launch" in the footer rather than a dead link.
NEXT_PUBLIC_PONZHOOD_X=
NEXT_PUBLIC_PONZHOOD_GITHUB=
